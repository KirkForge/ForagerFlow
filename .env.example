# Optional endpoint for beacon telemetry (e.g. /api/telemetry).
# Leave empty to keep telemetry client-side only.
VITE_TELEMETRY_ENDPOINT=

# Sentry DSN for crash reporting and release health.
# Leave empty to skip Sentry initialization.
VITE_SENTRY_DSN=

# Optional sync backend URL and token for multi-device history sync.
# Leave empty for offline-only mode (no sync).
VITE_SYNC_URL=
VITE_SYNC_TOKEN=

# Feature flags (true/false or 1/0)
VITE_FEATURE_TELEMETRY=true

# Per-model free-storage thresholds for the pre-load confirmation (MB).
VITE_BVRA_MIN_FREE_MB=150
VITE_DIMA806_MIN_FREE_MB=500

# Inference retry settings
VITE_MAX_INFERENCE_RETRIES=3
VITE_RETRY_DELAY_MS=1000

# Camera capture resolution (square pixels)
VITE_CAPTURE_SIZE=224
