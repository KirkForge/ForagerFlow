{
  "name": "foragerflow",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first PWA for mushroom identification using ONNX runtime in the browser",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/copy-models-to-dist.cjs || true",
    "preview": "vite preview",
    "lint": "eslint src/ tests/ scripts/*.cjs --no-error-on-unmatched-pattern",
    "lint:fix": "eslint src/ tests/ scripts/*.cjs --no-error-on-unmatched-pattern --fix",
    "format": "prettier --write --no-error-on-unmatched-pattern src/ tests/ scripts/*.{cjs,mjs} *.json *.ts *.js *.html",
    "format:check": "prettier --check --no-error-on-unmatched-pattern src/ tests/ scripts/*.{cjs,mjs} *.json *.ts *.js *.html",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ci": "CI=true playwright test --project=chromium --project=firefox",
    "verify:labels": "node scripts/verify-labels.cjs",
    "verify:dist": "python3 scripts/test-dist.py",
    "verify:inference": "python3 scripts/test-inference.py smoke pwa/model/fungitastic.onnx pwa/model/fungitastic-classes.json pwa/model/dima806.onnx src/data/labels-dima806.json",
    "verify": "pnpm typecheck && pnpm lint && pnpm test:ci && pnpm build && pnpm verify:dist && pnpm verify:labels"
  },
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@playwright/test": "^1.61.0",
    "@types/eslint__js": "^9.14.0",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.3.2",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^4.1.8"
  }
}
