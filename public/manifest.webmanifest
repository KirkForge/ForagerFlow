{
  "id": "foragerflow",
  "name": "Foragerflow",
  "short_name": "Foragerflow",
  "description": "Offline-first PWA for mushroom identification using ONNX models in the browser.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen"],
  "orientation": "any",
  "lang": "en",
  "dir": "ltr",
  "background_color": "#0f1115",
  "theme_color": "#0f1115",
  "categories": ["education", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Identify",
      "short_name": "Identify",
      "description": "Open the camera and identify a mushroom",
      "url": "/",
      "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192" }
      ]
    },
    {
      "name": "History",
      "short_name": "History",
      "description": "View past identifications",
      "url": "/?history",
      "icons": [
        { "src": "/icons/icon-192.png", "sizes": "192x192" }
      ]
    }
  ]
}
