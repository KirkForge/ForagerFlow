# --- Local ONNX weights are included in production builds ---
# pwa/model/*.onnx is intentionally NOT ignored here so the builder stage can
# copy the exported weights into dist/model/. Exclude only partial/data sidecars
# that should not be shipped as standalone files.
pwa/model/*.onnx.data
pwa/model/*.onnx.external-data

